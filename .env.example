# ════════════════════════════════════════════════════════════════
# Hoshino Blog 配置模板
# 复制本文件为 .env 并填写自己的配置
# 注释的项目使用默认值，可不填
# 配置优先级：环境变量 > .env 文件 > config.py 默认值
# ════════════════════════════════════════════════════════════════

# ── 数据库 (MySQL) ────────────────────────────────────────────
# 完整连接串（优先级最高）
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4
# 或拆分单独配置（下面4项）：
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_USER=
# DB_PASS=
DB_NAME=hoshino_blog

# ── Redis ────────────────────────────────────────────────────
# 缓存 + 任务队列。不配置则静默降级（缓存失效、任务回落到本地线程）
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# ── Flask ────────────────────────────────────────────────────
# SECRET_KEY=自定义密钥，不填则自动生成并轮换
# SERVER_NAME=hoshino.example.com
# PREFERRED_URL_SCHEME=https
# FLASK_ENV=development
PORT=5000
# POSTS_PER_PAGE=6
# SITE_NAME=Hoshino
# DEFAULT_THEME=dark
# MAX_CONTENT_LENGTH=200MB

# ── 登录 ────────────────────────────────────────────────────
# ADMIN_USERNAME=
# ADMIN_PASSWORD=   # ⚠️ 必须设置强密码，切勿使用默认值
# ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Admin
# ENABLE_REGISTRATION=false

# ── 邮件 (SMTP) ─────────────────────────────────────────────
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_SSL=false
# MAIL_USE_TLS=true
# MAIL_USERNAME=user@example.com
# MAIL_PASSWORD=password
# MAIL_DEFAULT_SENDER=user@example.com

# ── B站爬虫 ────────────────────────────────────────────────
# 值越大 = 请求间隔越长 = 更低风控概率，但爬取更慢
# BILI_VIDEO_SLEEP=10        # 视频间基础间隔(秒)
# BILI_VIDEO_JITTER=5        # 视频间随机抖动(秒)
# BILI_INTERVAL=8            # 翻页基础间隔(秒)
# BILI_JITTER=4              # 翻页随机抖动(秒)
# BILI_SEMAPHORE=0           # API并发上限(0=自动=线程数+1)
# BILI_GLOBAL_RATE=0.33      # 全局令牌桶速率(请求/秒)，所有B站API请求统一限速；0.33≈20次/分钟
# BILI_GLOBAL_RATE_CAP=1     # 全局令牌桶突发上限(同时允许的请求数)；默认1=全串行，深扫+增量并发时最安全
# BILI_API_TIMEOUT=30        # 单次API超时(秒)
# BILI_COOLDOWN=3600         # 412熔断时长(秒)
# BILI_MAX_RUNNING=1800      # 任务卡死判定(秒)
# BILI_BATCH=3               # 深扫每批UP数（cap 4，超过强制降低）
# BILI_UPDATE_THREADS=3      # Hot/Warm/Cold视频更新并发线程数（cap 4）
# BILI_INCREMENTAL_THREADS=2 # 增量检查并发线程数（cap 2，超过强制降低）
# BILI_STAT_WORKERS=3        # 批量统计并发线程数
# BILI_INCREMENTAL_PAGES=2   # 增量检查翻页上限（动态流优先，无新视频时跳过 arc/search）
# BILI_INCREMENTAL_ARC_SEARCH=0 # 增量检查是否启用 arc/search 翻页（0=禁用，仅用动态流，降低风控；1=启用）
# BILI_INCREMENTAL_MINUTES=30 # 增量检查间隔(分钟)
# BILI_INCREMENTAL_TIMEOUT=900 # 增量检查整体硬超时(秒)，防止卡死导致资源累积
# BILI_TRACK_LATEST=5        # 获取最新N个视频的统计快照：增量检查时对每个UP最新发布的N个视频拉取播放/点赞等统计并写入历史快照表（用于趋势图）
# BILI_INCREMENTAL_CONSECUTIVE=30 # 增量检查连续N个已知视频即停止翻页（判断已无新视频）
# BILI_PAGE_SIZE=15          # 每页视频数（B站API单次返回上限）
# BILI_MAX_RETRIES=3         # 单请求风控最大重试次数
# BILI_RETRY_DELAY=30        # 风控指数退避初始等待(秒)
# BILI_BACKOFF_CAP=600       # 风控退避上限(秒)
# BILI_FIRST_DELAY=1.0,3.0   # 首次请求前随机短延迟范围(秒)，逗号分隔两个数字
# BILI_TIMEOUT=15            # HTTP请求超时(秒，login.py使用)
# BILI_COMMENT_HOT_PAGES=5   # 评论爬取热门页数
# BILI_COMMENT_NEWEST_PAGES=5 # 评论爬取最新页数
# BILI_COMMENT_SLEEP=4.0     # 评论页间隔基础(秒)
# BILI_COMMENT_JITTER=3.0    # 评论页间隔随机抖动(秒)
# BILI_COMMENT_RISK_SLEEP=15 # 评论触发风控后的等待(秒)
# BILI_COMMENT_WORKERS=3     # 评论刷新并发线程数
# BILI_REFRESH_LIMIT=50      # 评论/字幕刷新时单UP最多处理的视频数
# BILI_REFRESH_MAX_VIDEOS=30 # 手动刷新单个UP时单轮更新的视频数上限
# BILI_FILL_MAX_PAGES=       # 深扫补全阶段 arc/search 翻页上限（空=全量；新UP添加可设如 2 降低风控）
# BILI_ADD_COOLDOWN=300      # 添加新UP前检查的412冷却窗口(秒)：窗口内最近被封禁则拒绝添加
# BILI_HOT_DAYS=7            # Hot阶段：距发布≤N天的视频全量更新
# BILI_WARM_DAYS=30          # Warm阶段：距发布N~30天的视频
# BILI_FAIL_SLEEP=8.0        # 视频统计获取失败后的等待(秒)
# BILI_BLOCK_WINDOW=300      # 412封禁检测窗口(秒)：该窗口内被记录过412则触发熔断
# BILI_MAX_COOLDOWN=3600     # 412熔断最大时长(秒)
# BILI_COOKIE_FILE=          # Cookie文件路径（默认 .bili_cookies.txt，项目根目录）
# BILI_CREDENTIAL_FILE=      # Credential JSON路径（默认 .bili_credential.json，项目根目录）

# ── Worker ───────────────────────────────────────────────────
# WORKER_THREADS=3           # 爬取线程数
# WC_THREADS=3               # 词云线程数

# ── 其他 ────────────────────────────────────────────────────
# CACHE_TTL_SIDEBAR=300      # 侧边栏缓存时长(秒)
# CACHE_TTL_DASHBOARD=60     # 仪表盘缓存时长(秒)
# CACHE_TTL_RSS=600          # RSS缓存时长(秒)
# SCRAPING_PROXY=            # Amazon爬虫代理

# ── 数据库连接池 ─────────────────────────────────────────────
# DB_POOL_SIZE=20            # 连接池基础连接数（Web+Worker 共用，避免爬虫占用导致网页 500）
# DB_MAX_OVERFLOW=20         # 连接池溢出上限
# DB_POOL_TIMEOUT=20         # 获取连接超时(秒)
# DB_POOL_RECYCLE=1800       # 连接回收周期(秒)